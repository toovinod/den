{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"daemon#build": {
			"outputs": ["dist/**"]
		},
		"desktop#build": {
			"dependsOn": ["daemon#build", "web#build"],
			"outputs": []
		}
	}
}
