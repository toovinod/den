# Cloud API (apps/api). Copy to .env and fill in. Never commit real values.
# Agent credentials (Anthropic or OpenAI keys, OAuth tokens) never go here: a Den login authenticates Den only.

# Port the API listens on. Defaults to 3001.
API_PORT=3001

# How long the API waits for requests in flight when it stops. Defaults to "10 seconds".
# Keep it a few seconds below the host's stop timeout, so requests finish before the host sends SIGKILL.
API_SHUTDOWN_GRACE=

# Public URL of the API, where Better Auth is mounted at /api/auth.
BETTER_AUTH_URL=http://localhost:3001

# Random secret of at least 32 characters, for example from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Origin of the static web app (sign-in, device approval, invite accept). The only CORS origin allowed.
WEB_ORIGIN=http://localhost:3000

# Postgres connection string. This default matches docker-compose.yml (`bun run db:up`).
# For Neon, use its connection string with sslmode=require.
DATABASE_URL=postgres://den:den@localhost:5432/den

# Redis for BullMQ. This default matches docker-compose.yml.
REDIS_URL=redis://localhost:6379

# GitHub OAuth app. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, for org invitation emails.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, for example "Den <invites@example.com>".
EMAIL_FROM=
