{
	"extends": "@repo/typescript-config/react-library.json",
	"compilerOptions": {
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"declaration": false,
		"declarationMap": false
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
