{
	"name": "swarm",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check-types": "turbo run check-types",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"husky": "9.1.7",
		"turbo": "^2.11.10",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
