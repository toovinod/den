{
	"name": "den",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check . && bun scripts/sortImports.ts",
		"format": "bun scripts/sortImports.ts --write && biome check --write .",
		"check-types": "turbo run check-types",
		"prepare": "husky",
		"setup": "bun install && bun run db:up && bun run db:migrate",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:migrate": "bun run --cwd packages/db-cloud db:migrate"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"husky": "9.1.7",
		"turbo": "2.11.10",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
