{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Den",
	"version": "0.1.0",
	"identifier": "app.den.desktop",
	"build": {
		"frontendDist": "../../web/out",
		"devUrl": "http://localhost:3000"
	},
	"app": {
		"windows": [
			{
				"title": "Den",
				"width": 1200,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
			"dangerousDisableAssetCspModification": ["style-src"]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"externalBin": ["../../daemon/dist/dend"]
	}
}
